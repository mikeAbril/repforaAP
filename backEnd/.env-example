MONGO_URI=mongodb://localhost:27017/certificados
PORT=3000
JWT_SECRET=s3cr3t_k3y_aut0m4t1z4c10n_c3rt1f1c4d0s_2026

# ============================================================
# GOOGLE DRIVE — OAuth2 (para cuentas personales)
# ============================================================
# REQUISITOS:
# 1. Ve a Google Cloud Console → APIs y Servicios → Credenciales
# 2. Crear credenciales → ID de cliente OAuth 2.0
# 3. Tipo de aplicación: Aplicación web
# 4. En "URI de redirección autorizada", agrega:
#    - Desarrollo: http://localhost:3000/api/drive/auth/callback
#    - Producción: https://tu-dominio.com/api/drive/auth/callback
# 5. Copia el ID de cliente y el secreto aquí
#
# NOTA: Las credenciales de autorización (tokens) se guardan en la base de datos.
#       Solo necesitas configurar el CLIENT_ID y CLIENT_SECRET aquí.
#       Usa el panel de administración en la app para autorizar.
GOOGLE_OAUTH_CLIENT_ID=tu_client_id_aqui
GOOGLE_OAUTH_CLIENT_SECRET=tu_client_secret_aqui

# Opcional: ID de una carpeta específica en Drive para usar como raíz.
# Si no se define, se creará/usará una carpeta llamada "PLANILLAS" en Mi Drive.
GOOGLE_DRIVE_FOLDER_ID=

# ============================================================
# OTROS
# ============================================================
# Clave de 32 caracteres para encriptación interna (API Keys de supervisores)
CRYPTO_KEY=12345678901234567890123456789012

# ============================================================
# SCRAPERS
# ============================================================
# false = navegador visible (desarrollo/debug)
# true  = sin interfaz gráfica (producción/servidor)
# Si no se define, por defecto es true
HEADLESS=false

# ============================================================
# NODEMAILER (Configuración de correo)
# ============================================================
MAIL_USER=[EMAIL_ADDRESS]
MAIL_PASS=tu_password_de_aplicacion

# ============================================================
# NOTA: No se necesita FRONTEND_URL.
# El sistema detecta automáticamente el dominio en producción.
# ============================================================